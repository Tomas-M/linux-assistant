ASSISTANT_LISTEN=127.0.0.1:8787
ASSISTANT_PUBLIC_URL=https://assistant.example.com
ASSISTANT_DATABASE=/var/lib/linux-assistant/assistant.db
ASSISTANT_FREE_CREDITS=100
# Credits per 1,000,000 tokens. Restart the backend after changes; new tasks use these rates.
ASSISTANT_INPUT_CREDITS_PER_MILLION=200
ASSISTANT_CACHED_INPUT_CREDITS_PER_MILLION=10
ASSISTANT_OUTPUT_CREDITS_PER_MILLION=1000
# Optional operator dashboard at /admin. Use a unique password of at least 16 bytes.
# ASSISTANT_ADMIN_PASSWORD=generate-a-private-random-password-on-the-server
# Create each account with: assistant-server --login-account DIRECTORY
ASSISTANT_CODEX_HOMES=/var/lib/linux-assistant/account-1
# Omit ASSISTANT_MODEL to use the signed-in account's default model.
# ASSISTANT_MODEL=your-available-model
# Optional reasoning override for all replies, output analysis and administrator tests.
# Choose a level supported by your model; omit to preserve Codex's thread default.
# ASSISTANT_REASONING_EFFORT=medium
# SMTP uses implicit TLS (SMTPS); enter a hostname without ssl://.
ASSISTANT_SMTP_HOST=smtp.gmail.com
ASSISTANT_SMTP_PORT=465
ASSISTANT_SMTP_USERNAME=tomas@slax.org
# Gmail requires an app password; configure it only in the private server.env file.
ASSISTANT_SMTP_PASSWORD=replace-on-server
ASSISTANT_EMAIL_FROM="Linux Assistant <tomas@slax.org>"
# Optional user sign-in providers. Each button appears only when both credentials are set.
# Register the exact callback URLs listed in deploy/SOCIAL_SIGN_IN.md, then restart the backend.
# GOOGLE_CLIENT_ID=replace-on-server
# GOOGLE_CLIENT_SECRET=replace-on-server
# MICROSOFT_CLIENT_ID=replace-on-server
# MICROSOFT_CLIENT_SECRET=replace-on-server
# GITHUB_CLIENT_ID=replace-on-server
# GITHUB_CLIENT_SECRET=replace-on-server
# Set all three Stripe fields together; use a one-time Price from the same Stripe mode.
# STRIPE_SECRET_KEY=replace-on-server
# STRIPE_WEBHOOK_SECRET=replace-on-server
# STRIPE_PRICE_ID=replace-with-one-time-price-id
ASSISTANT_PACK_CREDITS=100
